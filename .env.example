# App
APP_ENV=local
LOG_LEVEL=INFO

# LLM provider
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.4-2026-03-05
AGENT_REASONING_EFFORT=none
ROUTER_MODEL=gpt-5.4-mini
ROUTER_REASONING_EFFORT=low
CONVERSATIONAL_MODEL=gpt-5.4-mini
CONVERSATIONAL_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=120
AGENT_TIMEOUT_SECONDS=180

# Local data
DATA_DIR=data
SANDBOX_DIR=sandbox

# Conversation checkpoints: unset keeps them in memory; a path persists them
# in SQLite across restarts.
# CHECKPOINT_DB=.data/checkpoints.sqlite
# Recent messages sent to the router/conversational and investigator models
ROUTER_HISTORY_MESSAGES=12
AGENT_HISTORY_MESSAGES=40

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
